cc_defaults {
    name: "android.hardware.health-service.sony-defaults",

    defaults: ["libhealth_aidl_impl_user"],

    relative_install_path: "hw",

    vintf_fragments: ["android.hardware.health-service.sony.xml"],

    static_libs: ["libhealth_aidl_impl"],

    srcs: [
        "main.cpp",
        "CycleCountBackupRestore.cpp",
        "LearnedCapacityBackupRestore.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-fexceptions",
    ],

    required: [
        "sony_charger_res",
    ],
}

cc_binary {
    name: "android.hardware.health-service.sony",
    defaults: ["android.hardware.health-service.sony-defaults"],
    init_rc: ["android.hardware.health-service.sony.rc"],
    vendor: true,
    recovery: false,
    overrides: ["charger"],
}

cc_binary {
    name: "android.hardware.health-service.sony_recovery",
    defaults: ["android.hardware.health-service.sony-defaults"],
    init_rc: ["android.hardware.health-service.sony_recovery.rc"],
    vendor: false,
    recovery: true,
    overrides: ["charger.recovery"],
}

// animation.txt
prebuilt_etc {
    name: "sony_charger_res_values_animation",
    filename: "animation.txt",
    src: "res/values/animation.txt",
    relative_install_path: "res/values/charger",
    vendor: true,
}

// battery_fail.png
prebuilt_etc {
    name: "sony_charger_res_images_battery_fail",
    filename: "battery_fail.png",
    src: "res/images/battery_fail.png",
    relative_install_path: "res/images/charger",
    vendor: true,
}

// battery_scale.png
prebuilt_etc {
    name: "sony_charger_res_images_battery_scale",
    filename: "battery_scale.png",
    src: "res/images/battery_scale.png",
    relative_install_path: "res/images/charger",
    vendor: true,
}

// font_map.png
prebuilt_etc {
    name: "sony_charger_res_images_font_map",
    filename: "font_map.png",
    src: "res/images/font_map.png",
    relative_install_path: "res/images/charger",
    vendor: true,
}

phony {
    name: "sony_charger_res",
    required: [
        "sony_charger_res_values_animation",
        "sony_charger_res_images_battery_fail",
        "sony_charger_res_images_battery_scale",
        "sony_charger_res_images_font_map",
    ],
}
